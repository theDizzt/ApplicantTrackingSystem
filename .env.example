# =============================================================================
# AI 서류 심사관 (ATS) 환경변수 템플릿 — 이 프로젝트의 설정 파일은 .env 하나입니다.
#
# 복사해서 값을 채워 주세요:
#   macOS/Linux:  cp .env.example .env
#   Windows:      copy .env.example .env   (dev-windows.bat을 처음 실행하면 자동으로 만들어 줍니다)
#
# 개발 PC(dev-windows.bat, dev-macos.sh, VS Code), Docker, 서버 설치(install.sh)가
# 모두 이 .env 파일을 읽습니다. .env는 Git에 올라가지 않습니다.
# =============================================================================

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=atsdb
POSTGRES_USER=ats_user
# 반드시 변경 (아래 DATABASE_URL의 비밀번호와 같게)
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# 앱이 접속할 DB 주소. 실행 방식에 맞는 한 줄만 남기세요.
# 개발 PC (이 PC의 PostgreSQL, VS Code의 Docker DB)
DATABASE_URL=postgresql://ats_user:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/atsdb
# Docker 단일 서버 (docker-compose.yml): db 컨테이너를 가리킴
# DATABASE_URL=postgresql://ats_user:CHANGE_ME_DB_PASSWORD@db:5432/atsdb
# 별도 DB VM (docker-compose.web.yml): DB VM의 내부망 IP로 교체
# DATABASE_URL=postgresql://ats_user:CHANGE_ME_DB_PASSWORD@192.168.1.10:5432/atsdb

# ── 앱 시크릿 ───────────────────────────────────────────────────────────────
# 세션 암호화 키 — 충분히 길고 복잡한 문자열로 변경 (최소 32자)
# 생성 예시: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_SESSION_SECRET_MIN_32_CHARS

# ── 관리자 포털 ────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
# bcrypt 해시. 생성: htpasswd -bnBC 12 "" '강력한 비밀번호' | tr -d ':\n'
ADMIN_PASSWORD_HASH=CHANGE_ME_BCRYPT_HASH
# 일반 계정으로 로그인해도 관리자 페이지를 쓸 수 있는 이메일 (쉼표 구분, 비워 두면 없음)
ADMIN_EMAILS=

# ── AI API ──────────────────────────────────────────────────────────────────
# AI 분석 기능에 필요합니다. 비어 있어도 웹·API 서버는 실행됩니다.
AI_INTEGRATIONS_OPENAI_API_KEY=
# OpenAI 호환 API 엔드포인트 (기본값: OpenAI 공식). Azure OpenAI, 사설 프록시 등 사용 시 변경
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# 선택: 전용 OCR API 키. 비어 있으면 OpenAI 호환 비전 OCR로 폴백
MISTRAL_API_KEY=

# ── 개발 서버 포트 (dev-windows.bat, dev-macos.sh, VS Code) ────────────────
API_PORT=8080
WEB_PORT=3000

# 선택: 개발 서버를 HTTPS로 띄우기 (다른 기기에서 마이크 사용 시 필요). docs/HTTPS.md 참고
# DEV_HTTPS_CERT=certs/dev-cert.pem
# DEV_HTTPS_KEY=certs/dev-key.pem

# ── Docker 네트워크 바인딩 ─────────────────────────────────────────────────
# 앱 서비스 바인딩 (기본: 모든 인터페이스)
APP_HOST=0.0.0.0
APP_PORT=80

# DB 서비스 바인딩 (단일 서버: loopback, DB VM: 내부망 IP)
DB_HOST=127.0.0.1
DB_PORT=5432

# ── HTTPS (docker-compose.https.yml 사용 시) ───────────────────────────────
# 도메인의 DNS A 레코드가 이 서버를 가리켜야 합니다. docs/HTTPS.md 참고
DOMAIN=
ACME_EMAIL=
