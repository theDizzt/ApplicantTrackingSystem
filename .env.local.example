# VS Code / WSL local development only.
# Copy to .env.local and replace SESSION_SECRET before starting the API.
POSTGRES_DB=atsdb
POSTGRES_USER=ats_vscode
POSTGRES_PASSWORD=ats_vscode_local
DB_PORT=5432

DATABASE_URL=postgresql://ats_vscode:ats_vscode_local@127.0.0.1:5432/atsdb
SESSION_SECRET=replace-with-a-random-local-session-secret

API_PORT=8080
WEB_PORT=3000

# Optional. AI analysis features require a valid key.
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
