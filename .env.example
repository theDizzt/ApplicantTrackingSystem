# =============================================================================
# AI 서류 심사관 (ATS) 환경변수 템플릿
# 이 파일을 .env로 복사하고 값을 채워주세요:  cp .env.example .env
# =============================================================================

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# 단일 서버 구성 (docker-compose.yml): db 서비스 컨테이너 참조
DATABASE_URL=postgresql://ats_user:CHANGE_ME_DB_PASSWORD@db:5432/atsdb

# 별도 DB VM 구성 (docker-compose.web.yml): DB VM의 내부망 IP로 교체
# DATABASE_URL=postgresql://ats_user:CHANGE_ME_DB_PASSWORD@192.168.1.10:5432/atsdb

POSTGRES_DB=atsdb
POSTGRES_USER=ats_user
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD      # 반드시 변경

# ── 앱 시크릿 ───────────────────────────────────────────────────────────────
# 세션 암호화 키 — 충분히 길고 복잡한 문자열로 변경 (최소 32자)
# 생성 예시: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_SESSION_SECRET_MIN_32_CHARS

# ── OpenAI API ──────────────────────────────────────────────────────────────
# 실제 OpenAI API 키 (https://platform.openai.com/api-keys)
AI_INTEGRATIONS_OPENAI_API_KEY=sk-proj-CHANGE_ME

# OpenAI 호환 API 엔드포인트 (기본값: OpenAI 공식)
# Azure OpenAI, 사설 프록시 등 사용 시 변경
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# ── 네트워크 바인딩 ─────────────────────────────────────────────────────────
# 앱 서비스 바인딩 (기본: 모든 인터페이스)
APP_HOST=0.0.0.0
APP_PORT=80

# DB 서비스 바인딩 (단일 서버: loopback, DB VM: 내부망 IP)
DB_HOST=127.0.0.1
DB_PORT=5432
