{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "My ATS: Install dependencies",
      "type": "shell",
      "command": "pnpm install --frozen-lockfile",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "My ATS: Start local database",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "--env-file",
        ".env.local",
        "-f",
        "docker-compose.vscode.yml",
        "up",
        "-d",
        "--wait",
        "db"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "My ATS: Apply local database schema",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "set -a; source .env.local; set +a; pnpm --filter @workspace/db run push"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "My ATS: Start local database",
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "My ATS: Run web and API",
      "type": "shell",
      "command": "bash",
      "args": [
        "scripts/dev-vscode.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "My ATS: Start local database",
      "dependsOrder": "sequence",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false,
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "My ATS: Stop local database",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "--env-file",
        ".env.local",
        "-f",
        "docker-compose.vscode.yml",
        "down"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "My ATS: Typecheck web frontend",
      "type": "shell",
      "command": "pnpm run typecheck:frontend",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
